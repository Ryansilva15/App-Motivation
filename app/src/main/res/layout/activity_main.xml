<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/Linear_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/image_all"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_weight="1"
            android:src="@drawable/ic_all_inclusive"
             />

        <ImageView
            android:id="@+id/image_happy"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_weight="1"
            android:src="@drawable/ic_happy" />

         <ImageView
             android:id="@+id/image_sunny"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_weight="1"
            android:src="@drawable/ic__sunny" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_user_name"
        android:text="Olá, Kotlin!"
        android:layout_below="@id/Linear_menu"
        android:layout_centerHorizontal="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/text_phrase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="22sp"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_centerInParent="true"
        android:text="@string/app_name" />

    <View
        android:layout_width="128dp"
        android:layout_height="3dp"
        android:background="@color/black"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/text_phrase"
        android:elevation="5dp"/>

    <Button
        android:id="@+id/button_new_phrase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="@color/dark_purple"
        android:fontFamily="@font/cabin"
        android:text="@string/new_phrase" />

</RelativeLayout>
